{
  "name": "trendora",
  "version": "1.0.0",
  "private": true,
  "description": "Trendora - full stack MERN e-commerce marketplace (customer, seller and admin roles)",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "test": "npm test --prefix backend",
    "build": "npm run build --prefix frontend",
    "images:migrate": "npm run images:migrate --prefix backend"
  },
  "keywords": [
    "mern",
    "ecommerce",
    "react",
    "express",
    "mongodb",
    "stripe"
  ],
  "license": "MIT"
}
